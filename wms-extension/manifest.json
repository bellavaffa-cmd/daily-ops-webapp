{
  "manifest_version": 3,
  "name": "WMS → Report Error",
  "version": "3.48",
  "description": "Opens the Daily Ops report form for WMS packing orders, auto-triggers on carrier/AWB errors, and syncs LOCAD Ops attendance.",
  "content_scripts": [
    {
      "matches": ["https://wms.golocad.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://wms.companion.golocad.com/*"],
      "js": ["companion.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bellavaffa-cmd.github.io/daily-ops-webapp/*"],
      "js": ["closer.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://wms.golocad.com/*",
    "https://wms.companion.golocad.com/*",
    "https://partner.golocad.com/*",
    "https://dashboard.golocad.com/*",
    "https://bellavaffa-cmd.github.io/*",
    "https://mywmsquery.logiwa.com/*",
    "https://hmpkjmnxoidesnnoecfm.supabase.co/*"
  ],
  "permissions": ["tabs", "sidePanel", "storage", "alarms", "scripting"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Daily Ops"
  }
}
